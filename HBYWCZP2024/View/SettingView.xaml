<Page x:Class="HBYWCZP2024.View.SettingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HBYWCZP2024.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=local:SettingView}"
      Title="程序参数设定">
    <ScrollViewer>

        <Grid Margin="0,50,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1">

                <!--<TextBlock FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0">
                    工位名称
                </TextBlock>

                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="StationNameBox"
                    TextChanged="StationNameBox_TextChanged"
                ></TextBox>-->

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="MESIP"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="IPBox"
                    Text="{Binding ViewModel.Saves.MESIP, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="ECSIP"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="IPBox11"
                    Text="{Binding ViewModel.Saves.ECSUrl, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="FMS地址"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="ECSIPBox"
                    Text="{Binding ViewModel.Saves.FMSUrl, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="PLCIP"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.PLCPSetting.IP, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="设备号(ECS)"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.EquipNum, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="Mark下发等级"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.MarkCode, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="NG下发等级"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.NgCode, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="MES容器类型"/>
                <TextBox 
                    Width="200"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.ContainerTypeCode,Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="MES工序"/>
                <TextBox 
                    Width="200"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.LogisticsOperationCode,Mode=TwoWay}"/>        
                <Button 
                    IsEnabled="{Binding ViewModel.CanEditing}"
                    x:Name="SaveButton" 
                    Width="100"
                    Margin="0,20,0,0"
                    Click="SaveButton_Click"
                    Content="保存设定"/>

                <Button 
                    x:Name="TestChaiButton" 
                    Width="110"
                    Margin="0,25,0,0"
                    Content="测试数据拆盘"
                    Click="TestChaiButton_Click"/>

                <TextBlock
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="测试MES托盘号"/>
                <TextBox
                    Width="200"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.TestMesContainerCode, Mode=TwoWay}" />

                <Button
                    x:Name="TestMesContainerManualButton"
                    Width="180"
                    Margin="0,20,0,0"
                    Content="测试MES托盘信息获取"
                    Click="TestMesContainerManualButton_Click"/>

                <Button 
                    x:Name="TestBindCupButton" 
                    Width="110"
                    Margin="0,20,0,0"
                    Content="测试托杯绑定"
                    Click="TestBindCupButton_Click"/>       

            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock 
                    FontSize="15" 
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="EquipNum(FMS)"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="DeviceCode"
                    Text="{Binding ViewModel.Saves.EquipNum, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="SiteCode"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="Site"
                    Text="{Binding ViewModel.Saves.SiteCode, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="LineCode"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="Line"
                    Text="{Binding ViewModel.Saves.LineCode, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="EquipNum(MES)"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="EquipNum"
                    Text="{Binding ViewModel.Saves.DeviceCode, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="UserName(MES)"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.UserName, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="StepCode(FMS)"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.StepCode, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="StepCode2(FMS)"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.StepCode2, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="ProductModelCode(FMS)"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.ProductModelCode, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="产品型号(MES)"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.ProductType, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="特殊筛选目的工位号"/>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.FilterSpecialNum, Mode=TwoWay}"/>

                <TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                    Text="设备类型"/>
                <ComboBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="EquipmentTypeComboBox"
                    ItemsSource="{Binding ViewModel.EquipmentTypes}"
                    DisplayMemberPath="Value"
                    SelectedValuePath="Key"
                    SelectedValue="{Binding ViewModel.Saves.EquipType, Mode=TwoWay}"/>


                <StackPanel Orientation="Vertical" x:Name="ApiEnableStack">

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.CheckMaterialEnable}">入料校验接口使能(MES)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.FXQueryEnable}">分选入料校验(MES,I区分选)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.GRegionFXQueryEnable}">分选入料校验(MES,G区分选)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.TrayLevelUpdate}">分选档位上传(分选)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.AllLevelUploadEnable}">组盘上报所有电池档位(预分选,需启用分选档位上传)</CheckBox>
                    
                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.UploadFMSChaiHuanpanEnable}">换盘单拆上报FMS(筛选)</CheckBox>
                    
                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.HHFilterQueryEnable}">后氦Mark校验(MES,后氦)</CheckBox>
                    
                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.Mark2Enable}">后氦Mark复验(MES,后氦)</CheckBox>
                    
                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.CheckPalletMaterialEnable}">托盘电芯等级获取接口使能(MES,筛选)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.GrabActionInsertEnable}">组盘开始接口使能</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.GrabActionRemoveEnable}">组盘结束接口使能</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.ApplyMaterialEnable}">申请物料接口使能</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.PalletArrivedEnable}">托盘到位接口使能</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.CheckNullTrayEnable}">空托盘校验使能(MES,组盘)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.PalletOutEnable}">托盘离开接口是能</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.UploadMesDataEnable}">抓取结果上报MES接口使能(MES)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.UploadMesMpEndEnable}">组盘结束上报MES(整盘电芯)接口使能(MES)</CheckBox>
                    
                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.UploadFmsDataEnable}">上报FMS数据使能</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.HCInStationEnable}">化成首工序进站接口(暂时)使能(MES)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.HighTempEnable}">接口高温入库使能(MES)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.FilterSpecialEnable}">特殊筛选工位使能(筛选)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.GRegionCvRequestEnable}">G区预分选智能工位使能(筛选)</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.NGStationUpload}">NG站台上报FMS</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.UploadCupBindingToDbEnable}">托杯绑定上报数据库使能</CheckBox>

                    <CheckBox IsChecked="{Binding ViewModel.Saves.ApiEnableTable.ContainerManualEnable}">MES托盘信息获取使能</CheckBox>

                </StackPanel>

            </StackPanel>


            <StackPanel Grid.Column="3">
                <!--<TextBlock 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Text="调度号工位号表"/>-->

                <Button 
                    Margin="0,10,0,0" 
                    x:Name="StationSetting" 
                    Content="调度号工位号表配置"
                    Click="StationSetting_Click"/>

                <!--<TextBlock 
                    Margin="0,10,0,0" 
                    FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Text="条码规则表"/>-->

                <Button 
                    Margin="0,10,0,0" 
                    x:Name="RuleSetting" 
                    Click="RuleSetting_Click"
                    Content="条码规则表配置"/> 

                <Button 
                    Margin="0,10,0,0" 
                    x:Name="ResetTable" 
                    Click="ResetTable_Click"
                    Content="重置OPCUA缓存表"/>

                <TextBlock 
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,10,0,0" 
                    FontSize="15" 
                    Text="日志清理时间(天)"/>
                <TextBox
                    Margin="0,10,0,0"
                    Width="200"
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.LogDeleteDay}"/>

                <TextBlock
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,10,0,0"
                    FontSize="15"
                    Text="数据库日志清理保留时间(天)"/>
                <TextBox 
                    Margin="0,10,0,0" 
                    Width="200"
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.DatabaseLogDeleteDay}"/>

                <TextBlock 
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,10,0,0" 
                    FontSize="15" 
                    Text="心跳上报时间(ms)"/>
                <TextBox 
                    Margin="0,10,0,0" 
                    Width="200"
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.HeartbeartDuring}"/>

                <TextBlock
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,10,0,0" 
                    FontSize="15" 
                    Text="外部数据库连接串"/>
                <TextBox  
                    Margin="0,10,0,0" 
                    Width="200"
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.ExDbConnectionString}"/>

                <TextBlock
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,10,0,0" 
                    FontSize="15" 
                    Text="外部数据库表名"/>
                <TextBox  
                    Margin="0,10,0,0" 
                    Width="200"
                    HorizontalAlignment="Left"
                    Text="{Binding ViewModel.Saves.ExDbTableName}"/>

                <Button Width="110" Margin="0,10,0,0" Click="StationLevelConfig_Click" Content="工位等级配置"/>

                <Button Width="110" Margin="0,10,0,0"  Click="SetPlc_Click" Content="配置工位"/>

                <Button Width="110" Margin="0,10,0,0"  Click="FXLevelConfig_Click" Content="分选档位配置"/>

                <TextBlock 
                    Margin="0,10,0,0" 
                    FontSize="15" 
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Text="工位选择"/>
                <ComboBox 
                    Width="100" 
                    x:Name="SelectBox"
                    Margin="0,10,0,0" 
                    ItemsSource="{Binding ViewModel.Stations}"
                    SelectionChanged="ComboBox_SelectionChanged"/>

                <Button Width="100" Margin="0,10,0,0" Click="SetPower_Click" Content="权限配置"/>

                <CheckBox 
                    Margin="0,10,0,0" 
                    IsChecked="{Binding ViewModel.Saves.ExDb}">
                    多工位额外db flag
                </CheckBox>

                <CheckBox 
                    Margin="0,10,0,0" 
                    IsChecked="{Binding ViewModel.IsBackGround}">
                    是否有背景
                </CheckBox>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
