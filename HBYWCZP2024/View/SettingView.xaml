<Page x:Class="HBYWCZP2024.View.SettingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HBYWCZP2024.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=local:SettingView}"
      Title="SettingView">
    <ScrollViewer>

        <Grid Margin="0,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1">

                <!--<TextBlock FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                       >
                    工位名称
                </TextBlock>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="StationNameBox"
                    TextChanged="StationNameBox_TextChanged"
                ></TextBox>-->


                <TextBlock FontSize="15"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Margin="0,15,0,0"
                       >
                    MESIP
                </TextBlock>
                <TextBox 
                    Width="200" 
                    Margin="0,10,0,0" 
                    HorizontalAlignment="Left"
                    x:Name="IPBox"
                    Text="{Binding ViewModel.Saves.MESIP, Mode=TwoWay}"
                ></TextBox>

                <TextBlock FontSize="15"
    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
    Margin="0,15,0,0"
       >
    FMS地址
                </TextBlock>
                <TextBox 
    Width="200" 
    Margin="0,10,0,0" 
    HorizontalAlignment="Left"
    x:Name="ECSIPBox"
    Text="{Binding ViewModel.Saves.ECSIP, Mode=TwoWay}"
></TextBox>
                <TextBlock FontSize="15"
     Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
     Margin="0,15,0,0"
        >
     PLCIP
                </TextBlock>
                <TextBox 
     Width="200" 
     Margin="0,10,0,0" 
     HorizontalAlignment="Left"
     Text="{Binding ViewModel.Saves.PLCPSetting.IP, Mode=TwoWay}"
 ></TextBox>

                <TextBlock FontSize="15"
    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
    Margin="0,15,0,0"
       >
    设备号
                </TextBlock>
                <TextBox 
    Width="200" 
    Margin="0,10,0,0" 
    HorizontalAlignment="Left"
    Text="{Binding ViewModel.Saves.DeviceCode, Mode=TwoWay}"
></TextBox>

                <Button 
                IsEnabled="{Binding ViewModel.CanEditing}"
                
                x:Name="SaveButton" 
                    Width="100"
                    Margin="0,20,0,0"
                    Click="SaveButton_Click">保存设定</Button>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock FontSize="15"
    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
    Margin="0,15,0,0"
       >
    DeviceCode
                </TextBlock>
                <TextBox 
    Width="200" 
    Margin="0,10,0,0" 
    HorizontalAlignment="Left"
    x:Name="DeviceCode"
    Text="{Binding ViewModel.Saves.DeviceCode, Mode=TwoWay}"
></TextBox>
                <TextBlock FontSize="15"
     Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
     Margin="0,15,0,0"
        >
     SiteCode
                </TextBlock>
                <TextBox 
     Width="200" 
     Margin="0,10,0,0" 
     HorizontalAlignment="Left"
     x:Name="Site"
     Text="{Binding ViewModel.Saves.SiteCode, Mode=TwoWay}"
 ></TextBox>
                <TextBlock FontSize="15"
    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
    Margin="0,15,0,0"
       >
    LineCode
                </TextBlock>
                <TextBox 
    Width="200" 
    Margin="0,10,0,0" 
    HorizontalAlignment="Left"
    x:Name="Line"
    Text="{Binding ViewModel.Saves.LineCode, Mode=TwoWay}"
></TextBox>

                <TextBlock FontSize="15"
    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
    Margin="0,15,0,0"
       >
    EquipNum
                </TextBlock>
                <TextBox 
    Width="200" 
    Margin="0,10,0,0" 
    HorizontalAlignment="Left"
    x:Name="EquipNum"
    Text="{Binding ViewModel.Saves.EquipNum, Mode=TwoWay}"
></TextBox>


                <TextBlock FontSize="15"
    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
    Margin="0,15,0,0"
       >
    UserName(MES)
                </TextBlock>
                <TextBox 
    Width="200" 
    Margin="0,10,0,0" 
    HorizontalAlignment="Left"
    Text="{Binding ViewModel.Saves.UserName, Mode=TwoWay}"
></TextBox>


                <TextBlock FontSize="15"
    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
    Margin="0,15,0,0"
       >
    产品型号(MES)
                </TextBlock>
                <TextBox 
    Width="200" 
    Margin="0,10,0,0" 
    HorizontalAlignment="Left"
    Text="{Binding ViewModel.Saves.ProductType, Mode=TwoWay}"
></TextBox>

<StackPanel Orientation="Vertical" x:Name="ApiEnableStack">
                <CheckBox 
                    IsChecked="{Binding ViewModel.Saves.ApiEnableTable.CheckMaterialEnable}"
                    >入料校验接口使能(MES)</CheckBox>

                <CheckBox 
                    IsChecked="{Binding ViewModel.Saves.ApiEnableTable.CheckPalletMaterialEnable}"
                    >托盘电芯等级获取接口使能(MES,筛选)</CheckBox>
                <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.GrabActionInsertEnable}"
>组盘开始接口使能</CheckBox>

                <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.GrabActionRemoveEnable}"
>组盘结束接口使能</CheckBox>

                <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.ApplyMaterialEnable}"
>申请物料接口使能</CheckBox>

                <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.PalletArrivedEnable}"
>托盘到位接口使能</CheckBox>

                <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.PalletOutEnable}"
>托盘离开接口是能</CheckBox>
                    <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.UploadMesDataEnable}"
>抓取结果上报MES接口使能(MES)</CheckBox>
                <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.UploadFmsDataEnable}"
>上报FMS数据使能</CheckBox>

                <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.HCInStationEnable}"
>化成首工序进站接口(暂时)使能(MES)</CheckBox>
                <CheckBox 
IsChecked="{Binding ViewModel.Saves.ApiEnableTable.HighTempEnable}"
>接口高温入库使能(MES)</CheckBox>
            </StackPanel>
            </StackPanel>


            <StackPanel Grid.Column="3">
                <TextBlock FontSize="15"
       Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
       >
调度号工位号表
                </TextBlock>
                <Button Margin="0,10,0,0" x:Name="StationSetting" 
        Click="StationSetting_Click">配置</Button>

                <TextBlock Margin="0,10,0,0" FontSize="15"
       Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
       >
条码规则表
                </TextBlock>
                <Button Margin="0,10,0,0" x:Name="RuleSetting" 
        Click="RuleSetting_Click">配置</Button>

                <Button Margin="0,10,0,0" x:Name="ResetTable" 
Click="ResetTable_Click">重置OPCUA缓存表</Button>
                <TextBlock
Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
Margin="0,10,0,0" FontSize="15" 
>日志清理时间(天)</TextBlock>
                <TextBox  Margin="0,10,0,0" 
Width="200"
HorizontalAlignment="Left"
        Text="{Binding ViewModel.Saves.LogDeleteDay}"></TextBox>

                <TextBlock
Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
Margin="0,10,0,0" FontSize="15" 
>心跳上报时间(ms)</TextBlock>
                <TextBox  Margin="0,10,0,0" 
Width="200"
HorizontalAlignment="Left"
        Text="{Binding ViewModel.Saves.HeartbeartDuring}"></TextBox>

                <Button Width="100" Margin="0,10,0,0"  Click="SetPlc_Click">配置工位</Button>

                <TextBlock Margin="0,10,0,0" FontSize="15"
       Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
       >
工位选择
                </TextBlock>
                <ComboBox Width="100" 
                          x:Name="SelectBox"
                          Margin="0,10,0,0" 
                          ItemsSource="{Binding ViewModel.Stations}"
                          SelectionChanged="ComboBox_SelectionChanged"
                          ></ComboBox>

                <Button Width="100" Margin="0,10,0,0"  Click="SetPower_Click">权限配置</Button>

                <CheckBox Margin="0,10,0,0" 
          IsChecked="{Binding ViewModel.IsBackGround}">
                    是否有背景
                </CheckBox>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
