<UserControl x:Class="HBYWCZP2024.View.CZPallet.StationDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HBYWCZP2024.View.CZPallet"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DataContext="{d:DesignInstance Type=local:StationDetail}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="35" />
            <RowDefinition Height="70" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5,0,0,0"  Grid.Row="1">
            <Button Click="Button_Click">←返回</Button>
            <!--<Button x:Name="BindWithHuman" Click="BindWithHuman_Click">人工绑盘</Button>-->
            <Button x:Name="ScanAgain" Click="ScanAgain_Click">重新扫码</Button>
            <Button x:Name="Clear" Click="Clear_Click">清空</Button>

            <TextBlock 
                x:Name="PalletCodeBlock"
                Margin="10,0,0,0"
                Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
            VerticalAlignment="Center"
            FontSize="20"
                >托盘号：</TextBlock>
            <TextBox Margin="10,0,0,0"
                     x:Name="Pikachu"
                     Width="180"
                     InputMethod.IsInputMethodEnabled="false"
                       FontSize="20" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                       Text="{Binding Station.PalletCode}"></TextBox>
            <!--<Button x:Name="Confirm" 
                Margin="10,0,0,0"
                    Click="Confirm_Click">确认此条码（异常时点击）</Button>--> 
            
            <Button x:Name="Force" 
                Margin="10,0,0,0"
                    Click="Force_Click">强制写入条码</Button>
            <CheckBox 
                x:Name="BanSaoma"
                Margin="10,0,0,0"
                IsChecked="{Binding ViewModel.PalletViewModel.Pallet.BanSaoma}"
                >屏蔽扫码器</CheckBox>
            <Button x:Name="CvRequest" Click="CvRequest_Click">CvRequest</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock
                Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
            VerticalAlignment="Center"
            FontSize="20"
            TextAlignment="Center"
                >调度号：</TextBlock>
            <TextBlock
                Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                VerticalAlignment="Center" Grid.Row="1"
                FontSize="20"
                TextAlignment="Center"
                Text="{Binding Station.InsideNum}"
                   >
            </TextBlock>
            <TextBlock
                            VerticalAlignment="Center"
            FontSize="20"
            TextAlignment="Center"
            Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                Text=" 名称："></TextBlock>
            <TextBlock
            Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
            VerticalAlignment="Center" Grid.Row="1"
            FontSize="20"
            TextAlignment="Center"
            Text="{Binding Station.Name}"
                   >


            </TextBlock>

            <TextBlock
                            VerticalAlignment="Center"
            FontSize="20"
            TextAlignment="Center"
            Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                Text=" 工位号："></TextBlock>
            <TextBlock
            Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
            VerticalAlignment="Center" Grid.Row="1"
            FontSize="20"
            
            TextAlignment="Center"
            Text="{Binding Station.OutsideStationNum}"
                   >
            </TextBlock>
        </StackPanel>
        <ScrollViewer  
            Grid.Row="3"  
            VerticalScrollBarVisibility="Visible" 
            HorizontalScrollBarVisibility="Visible">
            <Viewbox Stretch="Uniform">
                <Viewbox.LayoutTransform>
                    <ScaleTransform ScaleX="0.25" ScaleY="0.22"/>
                </Viewbox.LayoutTransform>
                <local:PalletView  x:Name="PalletD">

            </local:PalletView>
            </Viewbox>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" Margin="0, 10, 0,0">
            <StackPanel 
                    Margin="10,0,0,0"
                Orientation="Horizontal">

                <Border Width="20" Height="20" BorderThickness="5" BorderBrush="Black"></Border>
                <TextBlock 
                    Margin="5,0,0,0"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    >空电池</TextBlock>
            </StackPanel>

            <StackPanel 
                    Margin="10,0,0,0"
                Orientation="Horizontal">

                <Border Width="20" Height="20" BorderThickness="5" BorderBrush="Green"></Border>
                <TextBlock 
                    Margin="5,0,0,0"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    >OK</TextBlock>
            </StackPanel>

            <StackPanel 
                    Margin="10,0,0,0"
                Orientation="Horizontal">

                <Border Width="20" Height="20" BorderThickness="5" BorderBrush="Red"></Border>
                <TextBlock 
                    Margin="5,0,0,0"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    >NG</TextBlock>
            </StackPanel>

            <StackPanel 
                    Margin="10,0,0,0"
                Orientation="Horizontal">

                <Border Width="20" Height="20" BorderThickness="5" BorderBrush="Purple"></Border>
                <TextBlock 
                    Margin="5,0,0,0"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    >假电池</TextBlock>
            </StackPanel>

            <StackPanel 
                    Margin="10,0,0,0"
                Orientation="Horizontal">

                <Border Width="20" Height="20" BorderThickness="5" BorderBrush="Blue"></Border>
                <TextBlock 
                    Margin="5,0,0,0"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    >Rework</TextBlock>
            </StackPanel>

            <!--<StackPanel 
                    Margin="10,0,0,0"
                Orientation="Horizontal">

                <Border Width="10" Height="10" BorderThickness="2" BorderBrush="Pink"></Border>
                <TextBlock 
                    Margin="5,0,0,0"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    >Rework2</TextBlock>
            </StackPanel>
            <StackPanel 
                    Margin="10,0,0,0"
                Orientation="Horizontal">

                <Border Width="10" Height="10" BorderThickness="2" BorderBrush="LightGreen"></Border>
                <TextBlock 
                    Margin="5,0,0,0"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    >OK2</TextBlock>
            </StackPanel>-->
        </WrapPanel>
        <!--要写出这个调度号的所有信息 另外其他实现再思考一下， 然后是plc流程还没完结 加速-->
    </Grid>
</UserControl>
