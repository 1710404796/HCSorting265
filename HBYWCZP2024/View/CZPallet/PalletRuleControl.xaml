<UserControl x:Class="HBYWCZP2024.View.CZPallet.PalletRuleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HBYWCZP2024.View.CZPallet"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:PalletRuleControl}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10"
            BorderThickness="2"
            Margin="10"
                BorderBrush="{DynamicResource SystemControlPageTextBaseHighBrush}">

        <Grid Margin="10">
            <StackPanel HorizontalAlignment="Center">
                <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                >
                    <TextBlock
                    Width="100"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" 
                    VerticalAlignment="Center"
                    >
                    托盘规则名:
                    </TextBlock>
                    <TextBox
                    Width="150"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" 
                    Text="{Binding PalletTypeRule.Name}"
                    x:Name="PalletRuleName"
                    >

                    </TextBox>

                </StackPanel>
                <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                >
                    <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" 
                    >
                    托盘正则:
                    </TextBlock>
                    <TextBox
                    Width="150"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" 
                    Text="{Binding PalletTypeRule.PalletRule}"
                    x:Name="PalletRegex">

                    </TextBox>
                </StackPanel>

                <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                >
                    <TextBlock
                    Width="100"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" 
                    VerticalAlignment="Center"
                    >
                    托盘通道数:
                    </TextBlock>
                    <TextBox
                    Width="150"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" 
                    Text="{Binding PalletTypeRule.BatteryNum}"
                    x:Name="PalletFakeCode">

                    </TextBox>
                </StackPanel>

                <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                >
                    <TextBlock
                    Width="100"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" 
                    VerticalAlignment="Center"
                    >
                    配置电芯规则:
                    </TextBlock>
                    <Button
                    Width="150"
                    x:Name="SetBattery"
                        Click="SetBattery_Click">
                        配置
                    </Button>
                </StackPanel>
                <Button 
                    Margin="0,10,0,0"
                    x:Name="DeleteBtn" Click="DeleteBtn_Click" Width="100" HorizontalAlignment="Center">删除</Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
