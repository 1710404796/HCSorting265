<Window x:Class="HBYWCZP2024.View.User.PowerSettingWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HBYWCZP2024.View.User"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="权限设定页面" Height="800" Width="700"
        Loaded="PowerSettingWindows_OnLoaded"
        >
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" Name="sv1">
            <StackPanel x:Name="PowerPanel" Margin="0,0,0,30">
                <TextBlock HorizontalAlignment="Center" Margin="0,20,0,20" FontSize="20">权限设定</TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" HorizontalAlignment="Center" Width="100" Click="ButtonBase_OnClick">
            保存
        </Button>
    </Grid>

</Window>
