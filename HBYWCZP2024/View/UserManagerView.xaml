<Page x:Class="HBYWCZP2024.View.UserManagerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HBYWCZP2024.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserManagerView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Name="AddUser" Click="AddUser_Click" Margin="10">添加用户</Button>
            <Button Name="DelUser" Click="DelUser_Click" Margin="10">删除用户</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Width="120" VerticalAlignment="Center" Margin="205,10,5,10" Foreground="Black">用户名：</TextBlock>
            <TextBox x:Name="UserInfo" Height="30" Width="100" Margin="5,10,10,10"></TextBox>
            <Button x:Name="Select" Click="Select_Click">查询</Button>
            <!--<Button Click="Button_Click">踢啊</Button>-->
        </StackPanel>
        <ScrollViewer Grid.Row="1" Loaded="ScrollViewer_Loaded" >
            <DataGrid   
               Name="ddShow"
               AutoGenerateColumns="False" 
               CanUserAddRows="False" 
               RowHeaderWidth="0"
               ColumnWidth="*" 
             ItemsSource="{Binding ViewModel.Users}"
               RowEditEnding="ddShow_RowEditEnding"
               LoadingRow="ddShow_LoadingRow"
               HeadersVisibility ="Column">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Width="150"  Binding="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"></DataGridTextColumn>
                    <DataGridTextColumn Header="权限" Width="150"  Binding="{Binding PowerType, UpdateSourceTrigger=PropertyChanged}"></DataGridTextColumn>
                    <DataGridTextColumn Header="RFID" IsReadOnly="True" Width="150"  Binding="{Binding RFStar}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</Page>
