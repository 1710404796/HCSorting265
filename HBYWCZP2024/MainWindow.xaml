<Window x:Class="HBYWCZP2024.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HBYWCZP2024"
        mc:Ignorable="d"
      
       Closed="Window_Closed" 
        d:DataContext="{d:DesignInstance Type=local:MainWindow}"
      xmlns:view="clr-namespace:HBYWCZP2024.View"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        
        
        Title="MainWindow" Height="800" Width="1440">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <!--<ColumnDefinition></ColumnDefinition>-->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>



        <!--<Image  Source="Images/beier.png" Opacity="0.2" Grid.Column="1" Grid.Row="1" >
    
</Image>-->
        <Border CornerRadius="20" 
        Visibility="{Binding ViewModel.HasBackGround}"
        Margin="20" Grid.Column="1" Grid.Row="1">
            <Border.Background>
                <ImageBrush ImageSource="Images/beier.png"
                            Opacity="0.1" />
            </Border.Background>
        </Border>

        <TextBlock VerticalAlignment="Center"
           FontSize="20"
           HorizontalAlignment="Center"
           >HBYWCZP2024</TextBlock>
        <!--<TextBlock Grid.Column="1"
           VerticalAlignment="Center"
           HorizontalAlignment="Center"
           FontSize="20"
           Text="{Binding ViewModel.Title}"
           >

        </TextBlock>-->
        <Image 
    Grid.Column="1"
    VerticalAlignment="Center"
    Margin="0,5,100,5"
    Source="Images/linx.png" HorizontalAlignment="Center"></Image>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- <StackPanel></StackPanel> -->
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
            >PLC运行状态:</TextBlock>
            <TextBlock
                Text="{Binding ViewModel.PlcStatus}"
                
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="{Binding ViewModel.PlcColor}"
                Margin="10,0,0,0"

                ></TextBlock>
            <TextBlock VerticalAlignment="Center"
                       Margin="10,0,0,0"

                       Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                       FontSize="15" >当前操作用户:</TextBlock>
            <TextBlock VerticalAlignment="Center"
                       FontSize="15"
                       Margin="10,0,0,0"

                       Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                       Text="{Binding ViewModel.Username}"
                       ></TextBlock>
            <!--<Button Click="Button_Click">Test</Button>-->
            <Button 
                Margin="10,0,20,0"
                Command="{Binding ViewModel.SignOutCommand}"
                Width="50" VerticalAlignment="Center">登出</Button>

        </StackPanel>

        <StackPanel Grid.Row="1" Visibility="Visible">

            <RadioButton 
        Style="{StaticResource MenuRadioButtonStyle}" 
        Cursor="Hand"
                x:Name="GongWeiBtn"
                Click="GongWeiBtn_Click"
        IsChecked="True"
        >
                工位状态
            </RadioButton>

            <RadioButton 
Style="{StaticResource MenuRadioButtonStyle}" 
Cursor="Hand"
                x:Name="WCSLog"
                Click="WCSLog_Click"
>
                WCS交互日志
            </RadioButton>
            <RadioButton 
Style="{StaticResource MenuRadioButtonStyle}" 
Cursor="Hand"
                x:Name="WarningLog"
                Click="WarningLog_Click"
>
                报警日志
            </RadioButton>


            <RadioButton 
        Style="{StaticResource MenuRadioButtonStyle}" 
        Cursor="Hand"
        x:Name="LogDash"
        Click="LogDash_Click"
        >
                日志窗口
            </RadioButton>
            <RadioButton 
        Style="{StaticResource MenuRadioButtonStyle}" 
        Cursor="Hand"
        x:Name="Setting"
        Click="Setting_Click"
        >
                程序参数设定
            </RadioButton>
            <RadioButton 
        Style="{StaticResource MenuRadioButtonStyle}" 
        Cursor="Hand"
        x:Name="PowerManager"
        Click="PowerManager_Click"
        >
                权限管理
            </RadioButton>
            <!--<CheckBox HorizontalAlignment="Center" 
              IsChecked="{Binding ViewModel.InsSaves.TestModel, UpdateSourceTrigger=PropertyChanged}"
        Visibility="{Binding ViewModel.View2}"
               Click="CheckBox_Click_1"
              >测试模式</CheckBox>-->
        </StackPanel>
       
        <Frame Grid.Row="1"
       Grid.Column="1"
       NavigationUIVisibility="Hidden"
       Margin="5,5,25,25"
       x:Name="ContentFrame">

        </Frame>

        <view:LockScreenView
Visibility="{Binding ViewModel.IsLock}"
x:Name="LockScreen" Grid.ColumnSpan="3" Grid.RowSpan="2">

        </view:LockScreenView>
        <view:Busying 
     Visibility="{Binding ViewModel.IsBusy}"
     Opacity="0.5"
     Progess="{Binding ViewModel.Progg}"
     BusyText="{Binding ViewModel.BusyMessage}"
     
     x:Name="BusyingScreen" Grid.ColumnSpan="2" Grid.RowSpan="2"></view:Busying>
    </Grid>
</Window>
