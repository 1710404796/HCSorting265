<UserControl x:Class="HCSortingCZP.View.CZPallet.PalletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HCSortingCZP.View.CZPallet" 
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             d:DataContext="{d:DesignInstance Type=local:PalletView}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Border 
            x:Name="PalletBorder"
            BorderThickness="2"
            CornerRadius="10"
            MouseDown="PalletBorder_MouseDown"
            Background="Transparent"
            BorderBrush="{DynamicResource SystemControlPageTextBaseHighBrush}">

            <StackPanel
                    Margin="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    x:Name="PalletStack">

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
