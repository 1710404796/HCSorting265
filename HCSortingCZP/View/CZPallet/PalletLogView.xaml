<Page x:Class="HCSortingCZP.View.CZPallet.PalletLogView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HCSortingCZP.View.CZPallet"
      mc:Ignorable="d" 
      xmlns:lang="clr-namespace:HCSortingCZP.Properties"
      Loaded="Page_Loaded"
      d:DataContext="{d:DesignInstance Type=local:PalletLogView}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="组盘日志">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="5">

            <Button Content="查询" Command="{Binding ViewModel.SearchCommand}"/>

            <DatePicker SelectedDate="{Binding ViewModel.StartTime}" Margin="10,0,0,0"/>

            <TextBlock 
                    VerticalAlignment="Center" 
                    Margin="10,0,0,0" 
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Text="至"/>

            <DatePicker SelectedDate="{Binding ViewModel.EndTime}" Margin="10,0,0,0"/>

            <TextBlock 
                    VerticalAlignment="Center" 
                    Margin="10,0,0,0"
                    Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                    Text="托盘条码"/>

            <TextBox 
                    Width="150" 
                    Margin="10,0,0,0" 
                    Text="{Binding ViewModel.Code}"
                    VerticalContentAlignment="Center"/>

            <Button Content="导出为CVS" Margin="10,0,0,0" Command="{Binding ViewModel.ExportCommand}"/>

        </StackPanel>

        <DataGrid Grid.Row="1" 
                  CanUserAddRows="False"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ItemsSource="{Binding ViewModel.PalletLogs}">

            <DataGrid.Columns>

                <DataGridCheckBoxColumn Header="勾选" Binding="{Binding IsSelect}" IsReadOnly="False"/>

                <DataGridTextColumn Header="托盘条码" Binding="{Binding PalletCode}" IsReadOnly="True"/>

                <DataGridTextColumn Header="组盘时间" Binding="{Binding ZuPanTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" IsReadOnly="True"/>

                <DataGridTextColumn Header="通道数" Binding="{Binding ChannelCount}" IsReadOnly="True"/>

                <!--<DataGridTextColumn Header="托盘信息" Binding="{Binding }" ></DataGridTextColumn>-->
                <DataGridTemplateColumn Header="托盘信息">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="托盘内容"
                                    Tag="{Binding }"  
                                    HorizontalAlignment="Stretch"
                                    Width="Auto"
                                    Click="PalletContents_Click" />     
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Content="上一页" Command="{Binding ViewModel.PreviousPageCommand}"
                    IsEnabled="{Binding ViewModel.HasPreviousPage}" Padding="12,4"/>
            <TextBlock Text="{Binding ViewModel.PageSummary}" VerticalAlignment="Center" Margin="12,0"/>
            <Button Content="下一页" Command="{Binding ViewModel.NextPageCommand}"
                    IsEnabled="{Binding ViewModel.HasNextPage}" Padding="12,4"/>
            <TextBlock Text="页码" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBox Width="64" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     Text="{Binding ViewModel.PageInput, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="确定" Command="{Binding ViewModel.JumpCommand}" Margin="6,0,0,0" Padding="12,4"/>
        </StackPanel>
    </Grid>
</Page>
