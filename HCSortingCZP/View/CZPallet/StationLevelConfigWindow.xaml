<Window x:Class="HCSortingCZP.View.CZPallet.StationLevelConfigWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:local="clr-namespace:HCSortingCZP.View.CZPallet"
		 
          xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
 mc:Ignorable="d"
 Title="工位等级配置" Height="450" Width="700">
 <DockPanel>
 <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
 <Button x:Name="AddBtn" Click="Add_Click" Width="80" Margin="0,0,10,0">新增</Button>
 <Button x:Name="RemoveBtn" Click="Remove_Click" Width="80" Margin="0,0,10,0">删除</Button>
 <Button x:Name="UpBtn" Click="Up_Click" Width="80" Margin="0,0,10,0">上移</Button>
 <Button x:Name="DownBtn" Click="Down_Click" Width="80" Margin="0,0,10,0">下移</Button>
 <Button x:Name="SaveBtn" Click="Save_Click" Width="100" Margin="20,0,0,0">保存</Button>
 </StackPanel>
 <DataGrid x:Name="Grid" ItemsSource="{Binding Datas}" AutoGenerateColumns="False" Margin="10" CanUserAddRows="False" SelectionMode="Single">
 <DataGrid.Columns>
 <DataGridTextColumn Header="工位号" Width="*" Binding="{Binding Station, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
 <DataGridTextColumn Header="电芯等级(数字)" Width="*" Binding="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
 </DataGrid.Columns>
 </DataGrid>
 <TextBlock DockPanel.Dock="Bottom" Margin="10" Foreground="DarkGray" TextWrapping="Wrap">
 提示：一个工位对应一种等级。仅输入数字等级。可以通过上移/下移调整优先级顺序。
 </TextBlock>
 </DockPanel>
</Window>
