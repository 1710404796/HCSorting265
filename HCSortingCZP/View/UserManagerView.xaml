<Page x:Class="HCSortingCZP.View.UserManagerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HCSortingCZP.View"
      xmlns:lang="clr-namespace:HCSortingCZP.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserManagerView">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12,10"
                Style="{StaticResource DashboardCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Name="AddUser"
                            Click="AddUser_Click"
                            Width="100"
                            Margin="0,0,10,0">
                        添加用户
                    </Button>
                    <Button Name="DelUser"
                            Click="DelUser_Click"
                            Width="100">
                        删除用户
                    </Button>
                    <!--<Button Name="EditUser" Click="EditUser_Click" Margin="10">删除用户</Button>-->
                </StackPanel>
                <!--<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Width="72"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        用户名
                    </TextBlock>
                    <TextBox x:Name="UserInfo"
                             Height="32"
                             Width="150"
                             Margin="0,0,10,0"/>
                    <Button x:Name="Select"
                            Content="{x:Static lang:Resources.Query}"
                            Width="92"
                            Click="Select_Click"/>
                    --><!--<Button Click="Button_Click">踢啊</Button>--><!--
                </StackPanel>-->
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Padding="8"
                Style="{StaticResource DashboardCard}">
            <ScrollViewer Loaded="ScrollViewer_Loaded">
                <DataGrid Name="ddShow"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          ColumnWidth="*"
                          ItemsSource="{Binding ViewModel.Users}"
                          RowEditEnding="ddShow_RowEditEnding"
                          LoadingRow="ddShow_LoadingRow"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static lang:Resources.Username}"
                                            Width="150"
                                            Binding="{Binding LinxUser.UserName, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="{x:Static lang:Resources.Identity}"
                                            Width="150"
                                            Binding="{Binding Role, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="RFID"
                                            IsReadOnly="True"
                                            Width="150"
                                            Binding="{Binding PassStar}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
