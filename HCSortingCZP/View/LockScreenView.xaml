<UserControl x:Class="HCSortingCZP.View.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HCSortingCZP.View"
      xmlns:lang="clr-namespace:HCSortingCZP.Properties"
             mc:Ignorable="d" 
             Focusable="True"
             Loaded="UserControl_Loaded"
             IsVisibleChanged="UserControl_IsVisibleChanged"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Border Width="430"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="&#xE72E;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="32"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Margin="0,14,0,0"
                           Text="{x:Static lang:Resources.ProgramIsLocked}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Margin="0,24,0,6"
                           Text="RFID / 卡号"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"/>
                <PasswordBox x:Name="Dani"
                             Height="38"
                             PasswordChar="*"
                             KeyDown="Dani_KeyDown"
                             PasswordChanged="Dani_PasswordChanged"
                             Foreground="{DynamicResource TextBrush}"
                             InputMethod.IsInputMethodEnabled="False"/>
                <TextBlock x:Name="ErrorText"
                           Margin="0,8,0,0"
                           MinHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12"/>
                <Button x:Name="LoginButton"
                        Height="38"
                        Margin="0,12,0,0"
                        Content="{x:Static lang:Resources.Login}"
                        Click="LoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
