<Window x:Class="HCSortingCZP.View.AutoClassEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HCSortingCZP.View"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        
          xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="AutoClassEditWindow" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <ScrollViewer Margin="10" Height="auto">
            <local:AutoFormGeneratorControl x:Name="MyForm"/>
        </ScrollViewer>
        <Button Click="Button_Click" Grid.Row="1" HorizontalAlignment="Center">
            保存设定
        </Button>
    </Grid>
</Window>
