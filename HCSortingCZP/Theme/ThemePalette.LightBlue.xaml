<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E3F2FD"/>
    <LinearGradientBrush x:Key="WindowBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1" Opacity="0.95">
        <GradientStop Color="#E3F2FD" Offset="0"/>
        <GradientStop Color="#BBDEFB" Offset="0.3"/>
        <GradientStop Color="#90CAF9" Offset="0.6"/>
        <GradientStop Color="#E3F2FD" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#D6EAF8"/>
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#E8F4F8"/>
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1" Opacity="0.85">
        <GradientStop Color="#F0F8FF" Offset="0"/>
        <GradientStop Color="#E1F5FE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#E1F5FE"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F7FCFF"/>
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#EAF6FD"/>
    <SolidColorBrush x:Key="DataGridRowBrush" Color="#F0F8FF"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#DFF2FC"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0288D1" Offset="0"/>
        <GradientStop Color="#03A9F4" Offset="0.5"/>
        <GradientStop Color="#00BCD4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HoverBrush" Color="#B3E5FC"/>
    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0288D1" Offset="0"/>
        <GradientStop Color="#29B6F6" Offset="0.5"/>
        <GradientStop Color="#4FC3F7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#B3E5FC"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#81D4FA"/>
    <LinearGradientBrush x:Key="SubtleBorderBrush" StartPoint="0,0" EndPoint="1,1" Opacity="0.72">
        <GradientStop Color="#A7DFF4" Offset="0"/>
        <GradientStop Color="#C6EAF7" Offset="0.5"/>
        <GradientStop Color="#81D4FA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0288D1" Offset="0"/>
        <GradientStop Color="#03A9F4" Offset="0.5"/>
        <GradientStop Color="#00BCD4" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextBrush" Color="#1A2332"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#546E7A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0288D1"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#0277BD"/>
    <SolidColorBrush x:Key="PalletCellBackgroundBrush" Color="#F0F8FF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#00C853"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB300"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0288D1"/>
    <SolidColorBrush x:Key="ThemeSelectedBrush" Color="#0288D1"/>

    <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecundaryBackgroundColor" Color="#E1F5FE"/>
    <SolidColorBrush x:Key="PrimaryBlueColor" Color="#0288D1"/>
    <SolidColorBrush x:Key="PrimaryGrayColor" Color="#546E7A"/>
    <SolidColorBrush x:Key="SecundaryBlueColor" Color="#BBDEFB"/>
    <SolidColorBrush x:Key="SecundaryGrayColor" Color="#D6EAF8"/>
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#1A2332"/>
    <SolidColorBrush x:Key="TextSecundaryColor" Color="#546E7A"/>
    <SolidColorBrush x:Key="ActionIconColor" Color="#1A2332"/>
    <SolidColorBrush x:Key="SystemControlPageTextBaseHighBrush" Color="#1A2332"/>
    <SolidColorBrush x:Key="SystemControlPageTextBaseMediumBrush" Color="#546E7A"/>
    <SolidColorBrush x:Key="SystemControlPageBackgroundAltHighBrush" Color="#E8F4F8"/>
    <SolidColorBrush x:Key="SystemControlPageBackgroundBaseLowBrush" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#D6EAF8"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#1A2332"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#546E7A"/>
    <SolidColorBrush x:Key="SystemControlHighlightAltTransparentBrush" Color="#00000000"/>

    <DropShadowEffect x:Key="CardShadow" Color="#4FC3F7" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
    <DropShadowEffect x:Key="AccentGlow" Color="#0288D1" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="StrongNeonGlow" Color="#00BCD4" BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>

</ResourceDictionary>
