<Window x:Class="HCSortingCZP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HCSortingCZP"
        mc:Ignorable="d"
      xmlns:lang="clr-namespace:HCSortingCZP.Properties"
       Closed="Window_Closed"
        Closing="Window_Closing"
        d:DataContext="{d:DesignInstance Type=local:MainWindow}"
      xmlns:view="clr-namespace:HCSortingCZP.View"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        WindowStartupLocation="CenterScreen"

        Title="HCSortingCZP"
        Height="950"
        Width="1640"
        Background="{DynamicResource WindowBackgroundGradientBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource WindowBackgroundGradientBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="208"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="24"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                IsHitTestVisible="False"/>
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                IsHitTestVisible="False"/>
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="12,12,12,10"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"/>

        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource AccentGradientBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Effect="{DynamicResource AccentGlow}">
                    <TextBlock Text="HC"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBackgroundColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="ApplicationTitle"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{Binding ViewModel.Saves.TrayScanStandardName}"/>
            </StackPanel>

            <Image Grid.Column="1"
                   Width="300"
                   Height="48"
                   Margin="16,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   Source="Images/linx.png"
                   IsHitTestVisible="False"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                <Button x:Name="UserManagementButton"
                        Style="{StaticResource HeaderUserButtonStyle}"
                        ToolTip="用户管理"
                        Click="UserManager_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{x:Static lang:Resources.CurrentOperator}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"/>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding ViewModel.Username}"/>
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeToggleButton"
                        Style="{StaticResource ThemeToggleButtonStyle}"
                        Margin="0,0,8,0"
                        Click="ThemeToggleButton_Click"
                        ToolTip="切换主题">
                    <TextBlock x:Name="ThemeToggleIcon"
                               Text="&#xE706;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"/>
                </Button>
                <Button Margin="0,0,8,0"
                        Command="{Binding ViewModel.SignOutCommand}"
                        Content="{x:Static lang:Resources.Logout}"
                        VerticalAlignment="Center"/>
                <!-- 语言切换暂时隐藏，保留语言初始化逻辑。 -->
                <!--
                <ComboBox VerticalAlignment="Center"
                          Width="100"
                          SelectionChanged="SelectLangBox_SelectionChanged"
                          x:Name="SelectLangBox">
                    <ComboBoxItem>中文</ComboBoxItem>
                    <ComboBoxItem>English</ComboBoxItem>
                    <ComboBoxItem>Magyar nyelv</ComboBoxItem>
                </ComboBox>
                -->
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
        Grid.Column="0"
        x:Name="NavigationTitle"
        Margin="16,12,0,0"
        VerticalAlignment="Top"
        Text="导航栏"
        FontSize="11"
        FontWeight="SemiBold"
        Foreground="{DynamicResource AccentBrush}"/>

        <ToggleButton Grid.Row="1"
                      Grid.Column="0"
                      x:Name="SidebarToggleButton"
                      Height="38"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      Margin="8,0,8,10"
                      Padding="0"
                      ToolTip="收起导航"
                      Click="SidebarToggleButton_Click">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="‹"
                           x:Name="SidebarToggleGlyph"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="收起导航"
                           x:Name="SidebarToggleLabel"
                           Margin="8,0,0,0"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <StackPanel Grid.Row="1"
        Grid.Column="0"
        x:Name="NavigationStack"
        Margin="10,42,10,58"
        Visibility="Visible">

            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="GongWeiBtn"
                         Tag="&#xE80F;"
                         ToolTip="工位状态"
                         Click="GongWeiBtn_Click"
                         IsChecked="True"
                         Content="工位状态"/>
            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="WCSLog"
                         Tag="&#xE8A5;"
                         ToolTip="WCS交互日志"
                         Click="WCSLog_Click"
                         Content="WCS交互日志"/>
            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="WarningLog"
                         Tag="&#xE7BA;"
                         ToolTip="报警日志"
                         Click="WarningLog_Click"
                         Content="报警日志"/>
            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="ZPLog"
                         Tag="&#xE8A5;"
                         ToolTip="组盘日志"
                         Click="ZPLog_Click"
                         Content="组盘日志"/>
            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="CPLog"
                         Tag="&#xE7C9;"
                         ToolTip="拆盘日志"
                         Click="CPLog_Click"
                         Content="拆盘日志"/>
            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="NgBeltCellLog"
                         Tag="&#xE7BA;"
                         ToolTip="NG拉带电芯日志"
                         Click="NgBeltCellLog_Click"
                         Content="NG拉带电芯日志"/>
            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="LogDash"
                         Tag="&#xE8A5;"
                         ToolTip="日志窗口"
                         Click="LogDash_Click"
                         Content="日志窗口"/>
            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="Setting"
                         Tag="&#xE713;"
                         ToolTip="程序参数设定"
                         Click="Setting_Click"
                         Content="程序参数设定"/>
            <!--
            <RadioButton Style="{StaticResource MenuRadioButtonStyle}"
                         x:Name="UserManager"
                         Tag="&#xE77B;"
                         ToolTip="用户管理界面"
                         Click="UserManager_Click"
                         Content="用户管理界面"/>
            -->
        </StackPanel>

        <Frame Grid.Row="1"
       Grid.Column="1"
       NavigationUIVisibility="Hidden"
       Margin="14"
       Background="Transparent"
       x:Name="ContentFrame">

        </Frame>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="7"
                            Height="7"
                            Margin="0,0,7,0"
                            Background="{DynamicResource SuccessBrush}"
                            CornerRadius="4"/>
                    <TextBlock Text="LINX机器人"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!--<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="TECH UI"
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,18,0"/>
                    <TextBlock Text="ONLINE"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>-->
            </Grid>
        </Border>

        <view:LockScreenView
Visibility="{Binding ViewModel.IsLock}"
x:Name="LockScreen" Grid.ColumnSpan="2" Grid.RowSpan="3">

        </view:LockScreenView>
        <view:Busying 
     Visibility="{Binding ViewModel.IsBusy}"
     Opacity="0.5"
     Progess="{Binding ViewModel.Progg}"
     BusyText="{Binding ViewModel.BusyMessage}"

     x:Name="BusyingScreen" Grid.ColumnSpan="2" Grid.RowSpan="3"></view:Busying>
    </Grid>
</Window>
